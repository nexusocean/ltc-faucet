# Litecoin node (testnet RPC port is 19332)
LTC_HOST=127.0.0.1
LTC_PORT=19332
LTC_USER=litecoin
LTC_PASS=
LTC_PROTOCOL=http
# Optional: send from a named wallet (required if the node has several loaded)
FAUCET_WALLET=

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=ltc-faucet

# Faucet
FAUCET_AMOUNT=0.1
COOLDOWN_HOURS=24
PORT=3000
HOST=127.0.0.1
# Set to true when running behind a reverse proxy, so the client IP comes from X-Forwarded-For
TRUST_PROXY=true
# Optional: testnet address where users can return unused coins. Use an address
# from the faucet's own wallet so returns refill the faucet.
RETURN_ADDRESS=
# Optional: real (mainnet) LTC address for supporting the faucet. Checked
# offline at startup, including the checksum.
DONATION_ADDRESS=
# Optional: Electrum-LTC server shown on the page, as host:port. Electrum uses
# SSL by default; add :t for a plain TCP port.
ELECTRUM_SERVER=
# Optional: public URL of the site, used for the canonical link and og:url.
PUBLIC_URL=
