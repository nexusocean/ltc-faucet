<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Litecoin Testnet Faucet</title>
  <meta name="description" content="Free Litecoin testnet faucet. Get {{ amount }} tLTC sent to your testnet address, once every {{ cooldownHours }} hours.{% if electrumServer %} Includes a public Electrum-LTC testnet server.{% endif %}">
  <meta name="robots" content="index, follow">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Litecoin Testnet Faucet">
  <meta property="og:description" content="Free Litecoin testnet faucet. Get {{ amount }} tLTC sent to your testnet address, once every {{ cooldownHours }} hours.">
  <meta name="twitter:card" content="summary">
  {% if publicUrl %}
  <link rel="canonical" href="{{ publicUrl }}">
  <meta property="og:url" content="{{ publicUrl }}">
  {% endif %}
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0f1a2e">
  <style>
    :root {
      --ltc-blue: #345d9d;
      --ltc-blue-light: #5b8bd6;
      --silver: #bfbbbb;
      --bg: #0f1a2e;
      --surface: #16243d;
      --border: #26385a;
      --text: #e6eaf2;
      --muted: #8f9bb3;
      --error: #ff6b6b;
      --success: #4fd1a5;
    }
    * { box-sizing: border-box; }
    body {
      font-family: system-ui, sans-serif; max-width: 34rem; margin: 0 auto; padding: 4rem 1rem;
      line-height: 1.5; color: var(--text); min-height: 100vh;
      background: radial-gradient(ellipse at top, #1d3158 0%, var(--bg) 60%) fixed, var(--bg);
    }
    header { display: flex; align-items: center; gap: .75rem; margin-bottom: .5rem; }
    .logo {
      flex: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; display: grid; place-items: center;
      background: var(--ltc-blue); color: #fff; font-size: 1.6rem; font-weight: 700;
      box-shadow: 0 0 0 3px var(--silver);
    }
    h1 { font-size: 1.6rem; margin: 0; }
    .github { margin-left: auto; color: var(--muted); display: flex; }
    .github:hover { color: var(--text); }
    .github svg { width: 1.6rem; height: 1.6rem; }
    h1 span { color: var(--ltc-blue-light); }
    p { color: var(--muted); }
    strong { color: var(--text); }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: .75rem; padding: 1.25rem; }
    form { display: flex; gap: .5rem; }
    input {
      flex: 1; min-width: 0; padding: .6rem .75rem; font: inherit; color: var(--text);
      background: var(--bg); border: 1px solid var(--border); border-radius: .5rem;
    }
    input:focus { outline: none; border-color: var(--ltc-blue-light); box-shadow: 0 0 0 3px rgb(91 139 214 / .25); }
    button {
      padding: .6rem 1.1rem; font: inherit; font-weight: 600; cursor: pointer; color: #fff;
      background: var(--ltc-blue); border: none; border-radius: .5rem;
    }
    button:hover { background: var(--ltc-blue-light); }
    button:disabled { opacity: .6; cursor: wait; }
    #balance { margin: .75rem 0 0; font-size: .9rem; }
    #result { margin-top: 1rem; word-break: break-all; }
    #result:empty { display: none; }
    .error { color: var(--error); }
    .success { color: var(--success); }
    .donate { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
    .donate h2 { font-size: 1.1rem; margin: 0 0 .5rem; }
    .donate-address { display: flex; gap: .5rem; align-items: center; }
    .donate-address code {
      flex: 1; padding: .5rem .75rem; background: var(--surface); border: 1px solid var(--border);
      border-radius: .5rem; color: var(--silver); word-break: break-all;
    }
    .donate-address button { background: transparent; border: 1px solid var(--ltc-blue-light); color: var(--ltc-blue-light); }
    .donate-address button:hover { background: var(--ltc-blue); color: #fff; }
  </style>
</head>
<body>
  <header>
    <div class="logo" aria-hidden="true">Ł</div>
    <h1>Litecoin <span>Testnet</span> Faucet</h1>
    <a class="github" href="https://github.com/nexusocean/ltc-faucet" title="Source on GitHub" aria-label="Source on GitHub">
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
    </a>
  </header>
  <p>Get {{ amount }} tLTC, once every {{ cooldownHours }} hours per address and IP.</p>

  <div class="card">
    <form id="claim">
      <input name="address" placeholder="Testnet address (tltc1…)" required autocomplete="off">
      <button type="submit">Claim</button>
    </form>

    <p id="balance"></p>
    <div id="result"></div>
  </div>

  {% if electrumServer %}
  <section class="donate" id="electrum">
    <h2>Use with Electrum-LTC</h2>
    <p>Check your coins in <strong>Electrum-LTC</strong> through our testnet server:</p>
    <div class="donate-address">
      <code>{{ electrumServer }}</code>
      <button type="button" class="copy">Copy</button>
    </div>
  </section>
  {% endif %}

  {% if returnAddress %}
  <section class="donate" id="return">
    <h2>Return testnet coins</h2>
    <p>Done testing? Send unused tLTC back so others can use them:</p>
    <div class="donate-address">
      <code>{{ returnAddress }}</code>
      <button type="button" class="copy">Copy</button>
    </div>
  </section>
  {% endif %}

  {% if donationAddress %}
  <section class="donate" id="donate">
    <h2>Support the faucet</h2>
    <p>Donations in <strong>real Litecoin (mainnet LTC)</strong> help cover hosting.
      Do not send testnet coins to this address.</p>
    <div class="donate-address">
      <code>{{ donationAddress }}</code>
      <button type="button" class="copy">Copy</button>
    </div>
  </section>
  {% endif %}

  <script>
    const form = document.getElementById('claim');
    const result = document.getElementById('result');
    const balance = document.getElementById('balance');

    fetch('/info')
      .then((r) => r.json())
      .then((info) => {
        balance.textContent = 'Faucet balance: ' + info.balance + ' tLTC';
      })
      .catch(() => {});

    for (const copy of document.querySelectorAll('.donate .copy')) {
      copy.addEventListener('click', async () => {
        const address = copy.previousElementSibling.textContent;
        try {
          await navigator.clipboard.writeText(address);
          copy.textContent = 'Copied';
        } catch {
          copy.textContent = 'Copy failed';
        }
        setTimeout(() => { copy.textContent = 'Copy'; }, 2000);
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button');
      button.disabled = true;
      result.className = '';
      result.textContent = 'Sending…';
      try {
        const res = await fetch('/claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ address: form.address.value }),
        });
        const body = await res.json();
        if (res.ok) {
          result.className = 'success';
          result.textContent = 'Sent ' + body.amount + ' tLTC. txid: ' + body.txid;
        } else {
          result.className = 'error';
          result.textContent = body.retryAt
            ? body.error + '. Try again after ' + new Date(body.retryAt).toLocaleString() + '.'
            : body.error || body.message || 'Request failed';
        }
      } catch {
        result.className = 'error';
        result.textContent = 'Request failed';
      } finally {
        button.disabled = false;
      }
    });
  </script>
</body>
</html>
